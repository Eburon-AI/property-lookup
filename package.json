{
  "name": "eburon-home",
  "version": "1.0.0",
  "private": true,
  "description": "Property management system for Eburon - Admin and Client portals",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:api": "dotenv -e .env -- turbo run dev --filter=api",
    "dev:client": "dotenv -e .env -- turbo run dev --filter=client-portal",
    "dev:admin": "dotenv -e .env -- turbo run dev --filter=admin-portal",
    "build": "dotenv -e .env -- turbo run build",
    "test": "dotenv -e .env -- turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "dotenv -e .env -- pnpm --filter @eburon/db migrate",
    "db:generate": "dotenv -e .env -- pnpm --filter @eburon/db generate",
    "db:seed": "pnpm --filter @eburon/db seed",
    "db:studio": "pnpm --filter @eburon/db studio"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.12.0",
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
